# Comma-separated list of nodes in format name:tailscale-ip
# Example: gpu-node-1:100.64.0.1,gpu-node-2:100.64.0.2,cpu-node-1:100.64.0.5
FARM_NODES=gpu-node-1:100.64.0.1,gpu-node-2:100.64.0.2

# Port the metrics agent runs on each compute node (default: 19999)
METRICS_PORT=19999

# How often (ms) the backend polls each node (default: 5000)
POLL_INTERVAL_MS=5000

# Web server port (Cloud Run sets this automatically)
PORT=8080

# Tailscale auth key for the Cloud Run container (ephemeral, reusable key)
# Generate at: https://login.tailscale.com/admin/settings/keys
TAILSCALE_AUTHKEY=tskey-auth-xxxx

# Optional: hostname this container registers as on Tailscale
TAILSCALE_HOSTNAME=farm-monitor
