# Local Bonsai-2-27B curation via llama.cpp llama-server (OpenAI-compatible)
# No auth is required for this server (apiKey optional; leave blank if none).
LLM_BASE_URL=http://127.0.0.1:8088/v1   # Docker on the llama.cpp host (10.0.10.3) -> loopback.
                                         # For a local (non-Docker) run from ANOTHER machine: http://10.0.10.3:8088/v1
LLM_API_KEY=
# The model id exactly as reported by GET /v1/models (confirmed to work).
LLM_MODEL=/home/steve/Downloads/Bonsai-demo/Bonsai-demo/models/bonsai2-gguf/27B/Ternary-Bonsai-2-27B-PQ2_0.gguf
LLM_TIMEOUT_MS=180000
LLM_MAX_TOKENS=2048

PORT=3000
DATA_DIR=./data
EMAIL_WEBHOOK_SECRET=choose_a_random_secret
